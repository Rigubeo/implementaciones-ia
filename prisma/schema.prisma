generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  CLIENT
  TEAM
}

enum ProjectStatus {
  DISCOVERY
  PROPOSAL
  IN_PROGRESS
  REVIEW
  DELIVERED
  SUPPORT
  PAUSED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
}

enum ReceiptType {
  RECEIPT
  INVOICE
  PAYMENT_PROOF
  OTHER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  role          UserRole @default(CLIENT)
  passwordHash  String?
  clientProfile Client?
  loyaltyStaff  LoyaltyStaff[]
  loyaltyCards  LoyaltyCard[]
  loyaltyEvents LoyaltyStampEvent[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Client {
  id            String              @id @default(cuid())
  userId        String?             @unique
  name          String
  company       String?
  phone         String?
  industry      String?
  notes         String?
  user          User?               @relation(fields: [userId], references: [id])
  projects      Project[]
  requests      DiagnosticRequest[]
  payments      Payment[]
  subscriptions Subscription[]
  reminders     Reminder[]
  receipts      Receipt[]
  loyaltyBusinesses LoyaltyBusiness[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

// Loyalty tables are server-only until explicit access controls are implemented.
model LoyaltyBusiness {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  client    Client   @relation(fields: [clientId], references: [id])
  staff     LoyaltyStaff[]
  programs  LoyaltyProgram[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model LoyaltyStaff {
  id         String @id @default(cuid())
  businessId String
  userId     String
  business   LoyaltyBusiness @relation(fields: [businessId], references: [id])
  user       User @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([businessId, userId])
  @@index([userId])
}

model LoyaltyProgram {
  id             String @id @default(cuid())
  businessId     String
  name           String
  reward         String
  promotion      String?
  theme          String @default("profesional")
  stampsRequired Int
  active         Boolean @default(true)
  business       LoyaltyBusiness @relation(fields: [businessId], references: [id])
  cards          LoyaltyCard[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([businessId, active])
}

model LoyaltyCard {
  id        String @id @default(cuid())
  programId String
  userId    String
  program   LoyaltyProgram @relation(fields: [programId], references: [id])
  user      User @relation(fields: [userId], references: [id])
  events    LoyaltyStampEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, userId])
  @@index([userId])
}

enum LoyaltyEventType {
  STAMP
  REDEMPTION
  ADJUSTMENT
}

model LoyaltyStampEvent {
  id             String @id @default(cuid())
  cardId         String
  actorId        String
  type           LoyaltyEventType
  stampsDelta    Int
  idempotencyKey String @unique
  note           String?
  card           LoyaltyCard @relation(fields: [cardId], references: [id])
  actor          User @relation(fields: [actorId], references: [id])
  createdAt      DateTime @default(now())

  @@index([cardId, createdAt])
  @@index([actorId])
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  title       String
  summary     String?
  status      ProjectStatus @default(DISCOVERY)
  n8nWorkflow String?
  budgetCents Int?
  currency    String        @default("mxn")
  client      Client        @relation(fields: [clientId], references: [id])
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model DiagnosticRequest {
  id           String   @id @default(cuid())
  clientId     String?
  name         String
  email        String
  phone        String
  businessType String
  message      String
  services     String[]
  source       String   @default("landing")
  client       Client?  @relation(fields: [clientId], references: [id])
  createdAt    DateTime @default(now())
}

model Payment {
  id                String          @id @default(cuid())
  clientId          String
  projectId         String?
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  amountCents       Int
  currency          String          @default("mxn")
  externalPaymentId String?
  checkoutUrl       String?
  paidAt            DateTime?
  client            Client          @relation(fields: [clientId], references: [id])
  project           Project?        @relation(fields: [projectId], references: [id])
  receipts          Receipt[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Subscription {
  id                     String             @id @default(cuid())
  clientId               String
  name                   String
  description            String?
  status                 SubscriptionStatus @default(ACTIVE)
  amountCents            Int
  currency               String             @default("usd")
  billingInterval        String             @default("month")
  billingDay             Int
  nextBillingAt          DateTime
  provider               PaymentProvider?
  externalSubscriptionId String?
  client                 Client             @relation(fields: [clientId], references: [id])
  reminders              Reminder[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([clientId, name])
  @@index([clientId, status])
  @@index([nextBillingAt])
}

model Reminder {
  id             String         @id @default(cuid())
  clientId       String
  subscriptionId String?
  title          String
  message        String
  daysBefore     Int?
  scheduledFor   DateTime
  status         ReminderStatus @default(SCHEDULED)
  sentAt         DateTime?
  client         Client         @relation(fields: [clientId], references: [id])
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([subscriptionId, daysBefore, scheduledFor])
  @@index([clientId, status, scheduledFor])
  @@index([status, scheduledFor])
}

model Receipt {
  id             String      @id @default(cuid())
  clientId       String
  paymentId      String?
  title          String
  documentNumber String?
  type           ReceiptType @default(RECEIPT)
  amountCents    Int?
  currency       String      @default("usd")
  issuedAt       DateTime
  storagePath    String      @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  client         Client      @relation(fields: [clientId], references: [id])
  payment        Payment?    @relation(fields: [paymentId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([clientId, issuedAt])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventType  String?
  externalId String?
  payload    Json
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())
}
